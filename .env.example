ARGOS_DATABASE_URL=postgresql+asyncpg://argos:CHANGE_ME@127.0.0.1:5432/argos
# Gere a chave com: python -m app.cli generate-key
ARGOS_MASTER_KEY=
ARGOS_ALLOWED_ROOTS=["data/workspace"]
ARGOS_COOKIE_SECURE=false
ARGOS_ALLOWED_HOSTS=["127.0.0.1","localhost","testserver"]
ARGOS_DATA_DIR=data
# Não é necessário colocar a API key aqui; cadastre no painel Modelos.
